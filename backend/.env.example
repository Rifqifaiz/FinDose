# Salin menjadi backend/.env lalu isi. File .env tidak boleh di-commit.

PORT=3001
HOST=0.0.0.0

# --- Fifin (Gemini Flash) ---
# API key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# FIFIN_AI=off   # paksa mode jawaban lokal

# --- Auth ---
# local    = email + password di SQLite (default)
# supabase = login lewat Supabase Auth; isi juga config.js di frontend
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
